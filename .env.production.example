# Copy to .env on the VPS (chmod 600) and fill in. Never commit the real file.
# `node deploy/generate-secrets.mjs` prints fresh values for every secret below.

DOMAIN=auth.synapseengineering.dev

# The identity role's password in Plano's PostgreSQL. Hex only: it sits in DATABASE_URL.
IDENTITY_DB_PASSWORD=
DATABASE_POOL_SIZE=5

# The provider's signing key (a private RSA JWK set, on one line) and cookie secrets.
# Changing the key signs everyone out of every app; keep both backed up.
OIDC_JWKS=
OIDC_COOKIE_KEYS=

# One secret per app; the same value goes into that app's own .env.
PLANO_CLIENT_SECRET=
ERUDI_CLIENT_SECRET=

# Outgoing e-mail (password recovery), through a Mailcow mailbox.
SMTP_HOST=mail.synapseengineering.dev
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Synapse <noreply@synapseengineering.dev>

PLANO_NETWORK=plano-prod_default
MAILCOW_NETWORK=mailcowdockerized_mailcow-network
