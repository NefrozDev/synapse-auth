PORT=3300
# The address people open: the Angular dev server, which proxies the API.
# The OpenID Connect issuer is this address followed by /oidc.
PUBLIC_URL=http://localhost:4300
DATABASE_URL=postgres://identity:identity@localhost:5434/identity
DATABASE_POOL_SIZE=5
# Registered apps and their addresses (secrets come from the variables they name).
OIDC_CLIENTS_FILE=config/clients.development.json
# Signing keys (a private JWK set as JSON) and cookie-signing secrets (comma-separated).
# Both may stay empty in development: the API then makes throwaway ones at start.
OIDC_JWKS=
OIDC_COOKIE_KEYS=
SESSION_TTL_DAYS=30
AUTH_SCRYPT_COST=32768
AUTH_SCRYPT_BLOCK_SIZE=8
AUTH_SCRYPT_PARALLELIZATION=3
# Outgoing e-mail (password recovery). Leave SMTP_HOST empty to send nothing:
# outside production the reset link is then written to the API log instead.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
